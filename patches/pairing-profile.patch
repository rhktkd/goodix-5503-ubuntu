diff --git a/src/goodix5503/identity.py b/src/goodix5503/identity.py
new file mode 100644
--- /dev/null
+++ b/src/goodix5503/identity.py
@@ -0,0 +1,16 @@
+"""Local Ubuntu integration: exact identities already admitted by the C driver.
+
+This module only checks strings. Provisioning separately attests the reset-time
+DN2 chip profile and R-family record before any persistent PSK write.
+"""
+from typing import Final
+
+EXPECTED_FIRMWARE: Final = "GF3258_RTSEC_APP_10063"
+POST_RESET_FIRMWARE: Final = "GF3208_RTSEC_APP_10063"
+PAIRING_FIRMWARE_IDS: Final = frozenset((EXPECTED_FIRMWARE, POST_RESET_FIRMWARE))
+EXPECTED_IAP: Final = "MILAN_RTSEC_IAP_10027"
+
+
+def require_pairing_identity(firmware: str, iap: str) -> None:
+    if firmware not in PAIRING_FIRMWARE_IDS or iap != EXPECTED_IAP:
+        raise RuntimeError(f"unsupported firmware/IAP: {firmware!r} / {iap!r}")
