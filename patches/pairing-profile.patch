 class ProvisioningError(RuntimeError):
     """A fixed provisioning precondition or postcondition failed."""
+
+
+def _attest_before_psk_write(
+    session: ReadOnlyUsbSession, expected_before: bytearray
+) -> None:
+    """Fixed volatile reset and DN2/R-record check; never writes Flash or PSK.
+
+    Reachable only after public confirmation, material validation and old-state
+    comparison. The public read-only transport whitelist remains unchanged.
+    Reset command/payload and the register query match the pinned C runtime.
+    """
+    if not isinstance(expected_before, bytearray) or len(expected_before) != 32:
+        raise ProvisioningError("expected pre-reset R record must be 32 mutable bytes")
+    response = session._ReadOnlyUsbSession__exchange(  # type: ignore[attr-defined]
+        0xA2, b"\x05\x14"
+    )
+    if not isinstance(response, (bytes, bytearray)) or len(response) > 4:
+        raise ProvisioningError("invalid fixed MCU reset response")
+    time.sleep(0.010)
+    chip_id = session.read_chip_id()
+    if chip_id != 0x220F:
+        raise ProvisioningError(
+            f"unsupported MCU chip profile {chip_id:#x}; expected DN2 0x220f; PSK not written"
+        )
+    firmware = _decode_c_string(session.request(COMMAND_FIRMWARE_VERSION))
+    iap = _decode_c_string(session.request(COMMAND_GET_IAP_VERSION, b"\x19\x00"))
+    try:
+        require_pairing_identity(firmware, iap)
+    except RuntimeError as error:
+        raise ProvisioningError(str(error)) from error
+    live_after_reset = bytearray()
+    try:
+        live_after_reset = _read_live_verification(session)
+        if not hmac.compare_digest(live_after_reset, expected_before):
+            raise ProvisioningError("R verification record changed during MCU reset; PSK not written")
+    finally:
+        live_after_reset[:] = b"\x00" * len(live_after_reset)
 
 
